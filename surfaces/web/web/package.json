{
  "name": "agentweb",
  "private": true,
  "type": "module",
  "description": "agentweb frontend: server-rendered shell + SolidJS islands in a DockView layout over the HostService Connect bridge (issue 1197)",
  "scripts": {
    "gen": "buf generate ../protos --template buf.gen.web.yaml",
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "@connectrpc/connect": "^2.1.0",
    "@connectrpc/connect-web": "^2.1.0",
    "@panyam/mcpkit-rooms": "^0.8.19",
    "@panyam/tsappkit": "^0.7.6",
    "@panyam/tsappkit-solid": "^0.7.6",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dockview-core": "^8.1.0",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.14.0",
    "@playwright/test": "1.64.1",
    "esbuild": "^0.28.2",
    "esbuild-plugin-solid": "^0.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
